@model IEnumerable<Circularify.Web.ViewModels.EventViewModelEntity>

<div class="col-md-6">
    <h2>Latest events</h2>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Event</th>
                <th>Sent</th>
                <th>Is Production</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count() > 0)
            {
                foreach (var evt in Model)
                {
                    var isProd = evt.IsProduction == true ? "Yes" : "No";

                    <tr>
                        <td>(#@evt.EventId) @evt.Event</td>
                        <td>@isProd (@evt.Sent.ToString("dd-MM-yyyy HH:mm:ss")</td>
                        <td>@isProd</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3">
                        No events found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
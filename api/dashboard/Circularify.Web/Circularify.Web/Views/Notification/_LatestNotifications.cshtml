@model IEnumerable<Circularify.Web.ViewModels.NotificationViewModelEntity>

<div class="col-md-6">
    <h2>Latest notifications</h2>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Message</th>
                <th>Is Production</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count() > 0)
            {
                foreach (var notification in Model)
                {
                    var isProd = notification.IsProduction == true ? "Yes" : "No";

                    <tr>
                        <td>(#@notification.NotificationId) @notification.Title</td>
                        <td>@notification.Message</td>
                        <td>@isProd</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3">
                        No notifications found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
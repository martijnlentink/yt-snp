@model IEnumerable<Circularify.Notifier.ViewModels.NotificationViewModelEntity>

@{
    ViewBag.Title = "Notification Overview";
}

<h2>@ViewBag.Title</h2>

<p>
    @Html.ActionLink("Create Notification", "Notify", null, new { @class = "btn btn-default" })
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Message)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsProduction)
            </th>
            <th>Action</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count() > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        (#@item.NotificationId) @item.Title
                    </td>
                    <td>
                        @item.Message
                    </td>
                    <td>
                        @{
                            var isProductionText = item.IsProduction == true ? "Yes" : "No";
                        }
                        @isProductionText
                    </td>
                    @if (item.HasAction)
                    {
                        <td>
                            @item.ActionText (@item.ActionUrl.Substring(0, 20)...)
                        </td>
                    }
                    else
                    {
                        <td>
                            No action defined.
                        </td>
                    }
                    <td>
                        <a onclick="Delete(@item.NotificationId)">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5">No notifications yet.</td>
            </tr>
        }
    </tbody>

</table>

<script typr="text/javascript">

    function Delete(id) {

        if (confirm("Are you sure you want to delete this notification?")) {

            $.ajax({
                url: "notify/delete/" + id
            })
            .done(function (result) {
                window.location.href = "/delete/redirect";
            });
        }
    };

</script>
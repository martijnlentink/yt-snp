@model IEnumerable<Circularify.Notifier.ViewModels.NotificationViewModelEntity>

@{
    ViewBag.Title = "Notification Overview";
}

<h2>@ViewBag.Title</h2>

<p>
    @Html.ActionLink("Create Notification", "Notify", null, new { @class = "btn btn-default" })
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Message)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ActionText)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ActionUrl)
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count() > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.NotificationId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Title)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Message)
                    </td>
                    @if (item.HasAction)
                    {
                        <td>
                            @Html.DisplayFor(modelItem => item.ActionText)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ActionUrl)
                        </td>
                    }
                    else
                    {
                        <td colspan="2">
                            No action defined.
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4">No notifications yet.</td>
            </tr>
        }
    </tbody>

</table>

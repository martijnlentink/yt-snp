{
  "name": "Frameless Window Sample",
  "description": "Chrome platform app.",
  "manifest_version": 2,
  "version": "0.2",
  "app": {
    "background": {
      "scripts": ["background.js"]
    }
  },
  "webview": {
    "partitions": [
      {
        "name": "static",
        "accessible_resources": [
          "js/core/modules.js",   
          "js/core/ytapi.js",
          "js/webview.js"
        ]
      }
    ]
  },
  "permissions": [
		"fullscreen",
    "overrideEscFullscreen",
    "webview",
		"*://*.youtube.com/*",
		"alwaysOnTopWindows"
	]
}
